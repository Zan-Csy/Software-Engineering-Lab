        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconStyle false\n\nclass \&quot;客户 (Customer)\&quot; as Customer {\n    - 姓名 (name): String\n    - 联系电话 (contact): String\n    - 邮寄地址 (deliveryAddress): String\n    - 是否激活 (active): boolean\n}\n\nclass \&quot;订单 (Order)\&quot; as Order {\n    - 创建日期 (createDate): Date\n    - 订单状态 (status): OrderStatus\n}\n\nclass \&quot;订单详情 (OrderDetail)\&quot; as OrderDetail {\n    - 数量 (quantity): int\n    + 计算小计 (calculateSubTotal)(): double\n    + 计算重量 (calculateWeight)(): double\n}\n\nclass \&quot;商品项 (Product)\&quot; as Product {\n    - 名称 (title): String\n    - 重量 (weight): double\n    - 描述 (description): String\n    + 按数量计价 (getPriceForQuantity)(quantity: int): double\n    + 获取重量 (getWeight)(): double\n}\n\nabstract class \&quot;支付方式 (Payment)\&quot; as Payment {\n    # 支付金额 (amount): double\n}\n\nclass \&quot;信用卡 (Credit)\&quot; as Credit {\n    - 卡号 (number): String\n    - 类型 (type): String\n    - 过期日期 (expiredDate): Date\n}\n\nclass \&quot;现金 (Cash)\&quot; as Cash {\n    - 支付金额 (cashTendered): double\n}\n\nclass \&quot;在线转账 (WireTransfer)\&quot; as WireTransfer {\n    - 银行ID (bankID): String\n    - 银行名称 (bankName): String\n}\n\nclass \&quot;支付宝 (AliPay)\&quot; as AliPay {\n    - 卡号 (number): String\n}\n\nclass \&quot;微信支付 (WeixinPay)\&quot; as WeixinPay {\n    - 卡号 (number): String\n}\n\n&#39; 5种支付方式继承自 Payment (泛化/继承关系: &lt;|--)\nPayment &lt;|-- Credit\nPayment &lt;|-- Cash\nPayment &lt;|-- WireTransfer\nPayment &lt;|-- AliPay\nPayment &lt;|-- WeixinPay\n\n&#39; 业务关联与多重性\nCustomer \&quot;1\&quot; -- \&quot;0..*\&quot; Order : 拥有\nOrder \&quot;1\&quot; *-- \&quot;1..*\&quot; OrderDetail : 包含 (组合)\nOrderDetail \&quot;*\&quot; -- \&quot;1\&quot; Product : 关联\nOrder \&quot;1\&quot; -- \&quot;1\&quot; Payment : 结算\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="70RrqgDbYfD8uNaxBs1k-1">
